# =============================================================================
# Environment reference — copy to `.env.local` (gitignored) for local dev.
#
# SECURITY
# - Never put SUPABASE_SERVICE_ROLE_KEY, GOOGLE_PRIVATE_KEY, session secrets,
#   or DATABASE_URL passwords in VITE_* / NEXT_PUBLIC_* — they are exposed to
#   the browser if prefixed for Vite.
# - Production: use Cloud Run env vars + Secret Manager for sensitive values.
# - `SUPABASE_ANON_KEY` is public by design (same as VITE_SUPABASE_ANON_KEY).
#
# The server reads process.env; Vite exposes only VITE_* and NEXT_PUBLIC_* to
# the client (see vite.config.ts `envPrefix`).
#
# --- Sheets + GCS MVP (no Supabase) — see docs/google-sheets-gcs-mvp.md ---
# DATA_BACKEND=sheets
# CATALOG_BACKEND=sheet
# DB_DRIVER=sqlite
# SQLITE_PATH=./estimator.db
# PROJECT_FILES_STORAGE=gcs
# GCS_PROJECT_FILES_BUCKET=
# DIV10_BRAIN_ENABLED=0
# (Omit VITE_SUPABASE_*, SUPABASE_URL, DATABASE_URL, DIRECT_URL for this profile.)
# =============================================================================

# --- Runtime (usually leave unset locally; Cloud Run sets PORT / K_*) ----------
# NODE_ENV=development
# PORT=3000
# APP_ENV=development
#
# Cloud Run injects K_SERVICE, K_REVISION, K_CONFIGURATION — do not set manually.

# =============================================================================
# CLIENT (browser) — safe to expose; must match server Supabase project
# =============================================================================

VITE_APP_NAME=Div 10 Catalog Hub
# Optional — only for Supabase Auth in the browser (Sheets MVP can omit both):
# VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_PUBLIC_KEY

# Optional UI flags
# VITE_SHOW_DIV10_ADMIN=0

# Aliases supported by Vite + server fallbacks (use same values as above):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# =============================================================================
# SUPABASE — optional (Postgres catalog, Storage, Div 10 Brain, Supabase Auth)
# =============================================================================

# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_PUBLIC_KEY
# SUPABASE_SERVICE_ROLE_KEY=PASTE_SUPABASE_SERVICE_ROLE_SECRET
# Settings → API → JWT Secret (used if AUTH_SESSION_SECRET not set for password-login cookie signing)
# SUPABASE_JWT_SECRET=

# Storage bucket for project files (create in Supabase Dashboard; default name below)
# SUPABASE_STORAGE_BUCKET=project-files

# --- SQLite → Supabase Storage backup (optional; when using durable SQLite + backup)
# DATABASE_SUPABASE_BUCKET=
# DATABASE_SUPABASE_OBJECT=estimator.db
# DATABASE_SUPABASE_BACKUP_INTERVAL_MS=

# =============================================================================
# DATABASE
# =============================================================================

# sqlite (local default) or pg (Supabase Postgres / production)
# DB_DRIVER=sqlite

# --- SQLite file path (when DB_DRIVER is not pg)
# DATABASE_PATH=./data/estimator.db

# --- Postgres (required when DB_DRIVER=pg) — use pooler URL on Cloud Run
# DATABASE_URL=postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# (Server adds uselibpqcompat=true for *.supabase.* hosts so Node/pg accept the pooler cert — see src/server/db/pgPool.ts.)

# Direct (non-pooler) URL for migrations / tooling that need prepared statements
# DIRECT_URL=postgresql://USER:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# PG_POOL_MAX=20
# TLS: Supabase pooler certs are relaxed automatically for *.supabase.* / *.pooler.supabase.com (see pgPool.ts).
# For other Postgres URLs, unset = default Node/pg verification; use 0 only if you trust the network path.
# PG_SSL_REJECT_UNAUTHORIZED=0
# PG_SSL_CA_PATH=

# Audit: scripts/supabase-install331-readiness-audit.sql (PASS/FAIL), then scripts/supabase-public-schema-audit.sql (full list).
# Ordered Postgres migrations + bridge path: docs/SUPABASE_CLOUD_RUN.md §2.
# If your Supabase model uses `projects`, `project_areas`, `takeoff_rows`, `bundle_defs`, … run
# scripts/supabase-bridge-native-to-install331-views.sql then set:
#   CATALOG_MODIFIERS_READ_TABLE=modifiers_v1
#   CATALOG_BUNDLES_READ_TABLE=bundles_v1
#   CATALOG_BUNDLE_ITEMS_READ_TABLE=bundle_items_v1
#   CATALOG_ITEM_ATTRIBUTES_READ_TABLE=catalog_item_attributes_compat
# Catalog — Supabase Postgres is authoritative in production
# CATALOG_BACKEND=pg
# Native Supabase (no *_clean views): use the physical table, e.g.:
# CATALOG_ITEMS_TABLE=public.catalog_items
# If you created install331-style clean views instead:
# CATALOG_ITEMS_TABLE=catalog_items_clean
# CATALOG_ITEMS_TABLE=public.catalog_items_clean
# CATALOG_SOURCE=supabase
# Google Sheets → Postgres import is OFF unless set to 1 (default unset = Supabase-only operators)
# CATALOG_SHEETS_SYNC_ENABLED=0
# AUTO_SYNC_CATALOG_ON_START=0
#
# Catalog operator modes: (A) Postgres-only — populate the table named by CATALOG_ITEMS_TABLE (default public.catalog_items)
# via Table Editor or SQL; the app reads it live and does not sync from Sheets. (B) Sheets as source of truth — set
# CATALOG_SHEETS_SYNC_ENABLED=1, configure Google + spreadsheet tab env vars, restart, then use Catalog → Import from Sheets.
# GET /api/v1/settings/integration-health lists resolved read surfaces (catalogItemsReadTable, catalogModifiersReadTable, …).
#
# With DB_DRIVER=pg there is no separate "sync from Supabase": the API reads Postgres live. On server boot the app
# runs a lightweight catalog read (inventory counts + resolved table names) and logs `[catalog] Postgres catalog ready`.
# The authenticated shell prefetches catalog meta into React Query so the Catalog page opens from cache.
#
# Set to 1 to log each GET /api/v1/catalog/items (relation name + row counts) on the server.
# CATALOG_DEBUG=1
#
# Native Supabase estimator workspace (default when DB_DRIVER=pg): projects, project_areas,
# takeoff_rows + v_takeoff_rows_estimate_pricing, pipeline RPCs/views under /api/v1/pipeline/*.
# Set to 1 only if you still use bridge/install331 *_v1 tables for workspace reads/writes:
# WORKSPACE_USE_LEGACY_V1=1
#
# Optional: map estimator workspace + catalog support tables to your Supabase names (whitelist only — see src/server/db/workspaceTable.ts, catalogTable.ts).
# Do not set WORKSPACE_TAKEOFF_LINES_TABLE to native takeoff_rows (different columns). Use the bridge VIEW takeoff_lines_v1 instead.
# CATALOG_ITEM_ALIASES_READ_TABLE=catalog_aliases
# CATALOG_ITEM_ALIASES_WRITE_TABLE=catalog_aliases
# CATALOG_BUNDLES_READ_TABLE=bundles
# CATALOG_BUNDLE_ITEMS_READ_TABLE=bundle_items

# =============================================================================
# AUTH
# =============================================================================

# Require login for API when 1/true/yes (see requireSession.ts)
# AUTH_REQUIRED=1

# Supabase Auth: set URL + anon key above. Optional fallback: single shared password (dev / break-glass)
# AUTH_LOGIN_PASSWORD=
# AUTH_LOGIN_EMAIL=
# Secret for signed cookie when using AUTH_LOGIN_PASSWORD (prefer dedicated value in prod)
# AUTH_SESSION_SECRET=

# Div 10 Brain — set 0 to disable even when Supabase + OpenAI are configured
# DIV10_BRAIN_ENABLED=0
# Admin HTTP routes (`/api/v1/div10-brain/*`) — Bearer or custom header
# DIV10_BRAIN_ADMIN_SECRET=

# =============================================================================
# GOOGLE — Gemini (intake, proposals, normalization); loaded at build for Vite bundle via define
# =============================================================================

# GEMINI_API_KEY=PASTE_GEMINI_KEY
# Required for vendor PDF/Word document intake (native file upload + structured line extraction).
# GOOGLE_GEMINI_API_KEY=      # alias for GEMINI_API_KEY

# GEMINI_MODEL=gemini-1.5-flash
# INTAKE_GEMINI_MODEL=        # overrides for intake path; falls back to GEMINI_MODEL

# INTAKE_SPREADSHEET_GEMINI_TIMEOUT_MS=120000
# INTAKE_GEMINI_MAX_RETRIES=3
# INTAKE_GEMINI_RETRY_BASE_MS=1000
# INTAKE_DIV10_MAX_LINES=10

# Heuristic vs LLM for upload normalization (see uploadRouter / normalizer)
# UPLOAD_LLM_NORMALIZATION=heuristic+optional-gemini

# =============================================================================
# GOOGLE — Document AI (vendor PDF intake — processDocument API)
# =============================================================================
# When GOOGLE_CLOUD_PROJECT_ID + DOCUMENT_AI_PROCESSOR_ID are set, PDF uploads use Document AI
# automatically (same as process_document_sample: project, location us, processor, mime_type).
# Set UPLOAD_PDF_PROVIDER=fallback-text to force pdf-parse only.

# GOOGLE_CLOUD_PROJECT_ID=gen-lang-client-0568373820
# DOCUMENT_AI_PROCESSOR_ID=7d47225afa5fabe8
# DOCUMENT_AI_LOCATION=us
# UPLOAD_PDF_PROVIDER=google-document-ai
# Uses GOOGLE_SERVICE_ACCOUNT JSON on Cloud Run (roles/documentai.apiUser on runtime SA).

# =============================================================================
# Div 10 estimator — three Google Sheets workbooks (DATA_BACKEND=sheets)
# =============================================================================
# Seed tabs/headers: npm run seed:div10-sheets:dry && npm run seed:div10-sheets
DATA_BACKEND=sheets
# CATALOG_BACKEND=sheet
# DB_DRIVER=sqlite
# SQLITE_PATH=./estimator.db

PROJECT_SETUP_ESTIMATE_PROPOSAL_SPREADSHEET_ID=1hE-q1QVwk7piPSX-_ux1xEFUXdcr85p8Jqr5ODbhDQ8
VENDOR_INTAKE_BACKEND_SPREADSHEET_ID=1hkRtCPCytPrDh7aQ9kEAbIa8prqindjV9W_VEvas_Vg
CATALOG_LABOR_BACKEND_SPREADSHEET_ID=1mEGJVAus_gCs6QU1c3PgxapQp-5D9s2mej5OpE8xIKY
DIV10_INSTALL_INTELLIGENCE_SPREADSHEET_ID=1GZXrFo0D_4TtkqxnFY8NLBXTCP33xwnpE4bPGmMVebE
# Optional alias if reusing catalog workbook for install intelligence tabs:
# CATALOG_INSTALL_INTELLIGENCE_SPREADSHEET_ID=
#
# Catalog/labor workbook tab overrides (defaults match Div 10: CatalogItems, CatalogAliases; legacy monolith often uses CATALOG_ITEMS).
# GOOGLE_SHEETS_TAB_CATALOG_ITEMS=CatalogItems
# GOOGLE_SHEETS_TAB_CATALOG_ALIASES=CatalogAliases
# GOOGLE_SHEETS_TAB_CATALOG_VENDOR_PRICES=CATALOG_VENDOR_PRICES
# GOOGLE_SHEETS_TAB_CATALOG_ATTRIBUTES=CATALOG_ATTRIBUTES
#
# Health check (after sign-in if AUTH_REQUIRED=1): GET /api/admin/div10-sheets/health
# Resolution + legacy aliases: see src/server/repos/dataBackend.ts and src/server/config/div10SheetsWorkbooks.ts

# =============================================================================
# GOOGLE — Sheets (catalog sync) & general ADC / service account
# =============================================================================

# Data backend switch (default DB-backed). Use `sheets` only with the three workbook ids above.
# DATA_BACKEND=sheets

# --- Legacy / compatibility spreadsheet IDs (deprecated — prefer Div 10 canonical names) ---
# Used only when the matching canonical env var above is unset (see dataBackend.ts / div10SheetsWorkbooks.ts).
# GOOGLE_PROJECTS_SPREADSHEET_ID=          # alias for PROJECT_SETUP_ESTIMATE_PROPOSAL_SPREADSHEET_ID
# GOOGLE_SETTINGS_SPREADSHEET_ID=          # Settings tab workbook when co-located with projects (same resolution chain)
# GOOGLE_CATALOG_SPREADSHEET_ID=            # alias for CATALOG_LABOR_BACKEND_SPREADSHEET_ID
# GOOGLE_SHEETS_SPREADSHEET_ID=            # legacy catalog workbook (if GOOGLE_CATALOG unset)
# GOOGLE_SHEETS_ID=                        # legacy catalog workbook alias

# Preferred: inline JSON or path / ADC
# GOOGLE_SERVICE_ACCOUNT={"type":"service_account",...}
# GOOGLE_SERVICE_ACCOUNT_BASE64=
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/sa.json
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

# Alternate: split email + PEM key
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_CLIENT_EMAIL=            # alias
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=   # legacy alias for GOOGLE_PRIVATE_KEY (same PEM)

# Spreadsheet tab names for catalog sync (defaults in code). Catalog **workbook** ids: Div 10 section + legacy block above.
# GOOGLE_SHEETS_TAB_ITEMS=CLEAN_ITEMS
# GOOGLE_SHEETS_TAB_CLEAN_ITEMS=CLEAN_ITEMS
# GOOGLE_SHEETS_TAB_MODIFIERS=CLEAN_MODIFIERS
# GOOGLE_SHEETS_TAB_CLEAN_MODIFIERS=CLEAN_MODIFIERS
# GOOGLE_SHEETS_TAB_BUNDLES=BUNDLES
# GOOGLE_SHEETS_TAB_ALIASES=ALIASES
# GOOGLE_SHEETS_TAB_ATTRIBUTES=ATTRIBUTES

# GOOGLE_SHEETS_AUTH_DEBUG=0

# Optional: minimum milliseconds between Sheets tab reads (values.get) to reduce 429 bursts in local dev (default 1100). Set 0 to disable pacing.
# GOOGLE_SHEETS_READ_MIN_INTERVAL_MS=1100

# Catalog sync tuning (see googleSheetsCatalogSync.ts)
# CATALOG_SYNC_REPLACE_MODE=
# CATALOG_SYNC_ALLOW_LEGACY_ITEMS_TAB=0
# CATALOG_SYNC_ALLOW_LEGACY_MODIFIERS_TAB=0
# CATALOG_SYNC_SKIP_STAGING=0
# CATALOG_SYNC_ITEMS_SOURCE=
# CATALOG_SYNC_DEMOTE_ORPHAN_REFS=
# CATALOG_SYNC_PREFLIGHT_STRICT_GENERIC_NAME_ALIASES=1  # block sync when one generic_name phrase maps to multiple SKUs (default: allow)
# PUBLISH_BLOCKERS_ALLOWED_CATEGORIES=

# DEFAULT_LABOR_RATE_PER_HOUR=100

# =============================================================================
# GOOGLE — Maps grounding (optional intake / geo)
# =============================================================================

# GOOGLE_MAPS_GROUNDING_ENABLED=0
# GOOGLE_MAPS_GROUNDING_API_KEY=
# GOOGLE_MAPS_API_KEY=            # fallback key
# GOOGLE_MAPS_GROUNDING_MODEL=

# =============================================================================
# GOOGLE — Cloud Storage (SQLite backup or project files alternate backend)
# =============================================================================

# DATABASE_GCS_BUCKET=
# DATABASE_GCS_OBJECT=estimator.db
# DATABASE_GCS_BACKUP_INTERVAL_MS=

# GCS bucket for project files when PROJECT_FILES_STORAGE=gcs (see gcsProjectFilesStorage.ts)
# PROJECT_FILES_STORAGE=gcs
# GCS_PROJECT_FILES_BUCKET=

# =============================================================================
# OPENAI — Div 10 Brain (embeddings, RAG); required if using div10 brain features
# =============================================================================

# OPENAI_API_KEY=
# OPENAI_MODEL_CLASSIFY=gpt-4o-mini
# OPENAI_MODEL_DRAFT=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# INTAKE — PDF / uploads / parsing
# =============================================================================

# fallback-text | document-ai (see pdfParser / intake-env-smoke)
# UPLOAD_PDF_PROVIDER=fallback-text   # force pdf-parse only (skip Document AI)

# =============================================================================
# ADDRESS SUGGEST (Nominatim)
# =============================================================================

# Default when unset: US-only + Midwest viewbox bias (reduces foreign "Springfield"/"Paris" hits).
# ADDRESS_SUGGEST_COUNTRY_CODES=us
# Set to world or * to search all countries (not recommended for US-centric workflows).

# Nominatim viewbox: west lon, north lat, east lon, south lat. Default is broad US Midwest.
# ADDRESS_SUGGEST_VIEWBOX=-104.5,49.4,-80.0,36.0
# Disable regional viewbox (country filter still applies if countrycodes set): ADDRESS_SUGGEST_VIEWBOX=off

# Strict: only return results inside viewbox (can hide valid US addresses outside the box).
# ADDRESS_SUGGEST_BOUNDED=0

# NOMINATIM_USER_AGENT=

# =============================================================================
# Other providers / features
# =============================================================================

# GOOGLE_NATURAL_LANGUAGE_ENABLED=0

# =============================================================================
# SERVER — catalog lifecycle, project files (SQLite), dev toggles
# =============================================================================

# Sync catalog from Sheets when server starts (see server.ts)
# AUTO_SYNC_CATALOG_ON_START=0

# Project file blobs: gcs (Cloud Run) | disk (local dev) | supabase (legacy pg + Supabase Storage)
# PROJECT_FILES_STORAGE=gcs
# PROJECT_FILES_DIR=./data/project-files

# ESTIMATOR_DEBUG_PROJECT_AUTOFILL=0

# =============================================================================
# Scripts only (migrations, smoke tests, one-off tools)
# =============================================================================

# SMOKE_HTTP_BASE=http://127.0.0.1:3000
# SQLITE_PATH=./estimator.db
# SQLITE_DB=                     # alias
# DRY_RUN=1
