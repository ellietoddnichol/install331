# =============================================================================
# Environment reference — copy to `.env.local` (gitignored) for local dev.
#
# SECURITY
# - Never put SUPABASE_SERVICE_ROLE_KEY, GOOGLE_PRIVATE_KEY, session secrets,
#   or DATABASE_URL passwords in VITE_* / NEXT_PUBLIC_* — they are exposed to
#   the browser if prefixed for Vite.
# - Production: use Cloud Run env vars + Secret Manager for sensitive values.
# - `SUPABASE_ANON_KEY` is public by design (same as VITE_SUPABASE_ANON_KEY).
#
# The server reads process.env; Vite exposes only VITE_* and NEXT_PUBLIC_* to
# the client (see vite.config.ts `envPrefix`).
# =============================================================================

# --- Runtime (usually leave unset locally; Cloud Run sets PORT / K_*) ----------
# NODE_ENV=development
# PORT=3000
# APP_ENV=development
#
# Cloud Run injects K_SERVICE, K_REVISION, K_CONFIGURATION — do not set manually.

# =============================================================================
# CLIENT (browser) — safe to expose; must match server Supabase project
# =============================================================================

VITE_APP_NAME=Div 10 Catalog Hub
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_PUBLIC_KEY

# Optional UI flags
# VITE_SHOW_DIV10_ADMIN=0

# Aliases supported by Vite + server fallbacks (use same values as above):
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# =============================================================================
# SUPABASE — server (set these on Cloud Run; mirror URL/anon to VITE_* for SPA)
# =============================================================================

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=PASTE_SUPABASE_SERVICE_ROLE_SECRET
# Settings → API → JWT Secret (used if AUTH_SESSION_SECRET not set for password-login cookie signing)
# SUPABASE_JWT_SECRET=

# Storage bucket for project files (create in Supabase Dashboard; default name below)
# SUPABASE_STORAGE_BUCKET=project-files

# --- SQLite → Supabase Storage backup (optional; when using durable SQLite + backup)
# DATABASE_SUPABASE_BUCKET=
# DATABASE_SUPABASE_OBJECT=estimator.db
# DATABASE_SUPABASE_BACKUP_INTERVAL_MS=

# =============================================================================
# DATABASE
# =============================================================================

# sqlite (local default) or pg (Supabase Postgres / production)
# DB_DRIVER=sqlite

# --- SQLite file path (when DB_DRIVER is not pg)
# DATABASE_PATH=./data/estimator.db

# --- Postgres (required when DB_DRIVER=pg) — use pooler URL on Cloud Run
# DATABASE_URL=postgresql://USER:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# (Server adds uselibpqcompat=true for *.supabase.* hosts so Node/pg accept the pooler cert — see src/server/db/pgPool.ts.)

# Direct (non-pooler) URL for migrations / tooling that need prepared statements
# DIRECT_URL=postgresql://USER:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# PG_POOL_MAX=20
# PG_SSL_REJECT_UNAUTHORIZED=1
# PG_SSL_CA_PATH=

# Catalog / estimator (see docs/catalog-sync-architecture.md)
# CATALOG_BACKEND=pg
# CATALOG_ITEMS_TABLE=public.catalog_items_clean
# CATALOG_SOURCE=supabase

# =============================================================================
# AUTH
# =============================================================================

# Require login for API when 1/true/yes (see requireSession.ts)
# AUTH_REQUIRED=1

# Supabase Auth: set URL + anon key above. Optional fallback: single shared password (dev / break-glass)
# AUTH_LOGIN_PASSWORD=
# AUTH_LOGIN_EMAIL=
# Secret for signed cookie when using AUTH_LOGIN_PASSWORD (prefer dedicated value in prod)
# AUTH_SESSION_SECRET=

# Div 10 Brain admin HTTP routes (`/api/v1/div10-brain/*`) — Bearer or custom header
# DIV10_BRAIN_ADMIN_SECRET=

# =============================================================================
# GOOGLE — Gemini (intake, proposals, normalization); loaded at build for Vite bundle via define
# =============================================================================

# GEMINI_API_KEY=PASTE_GEMINI_KEY
# GOOGLE_GEMINI_API_KEY=      # alias for GEMINI_API_KEY

# GEMINI_MODEL=gemini-2.5-flash
# INTAKE_GEMINI_MODEL=        # overrides for intake path; falls back to GEMINI_MODEL

# INTAKE_SPREADSHEET_GEMINI_TIMEOUT_MS=12000
# INTAKE_DIV10_MAX_LINES=10

# Heuristic vs LLM for upload normalization (see uploadRouter / normalizer)
# UPLOAD_LLM_NORMALIZATION=heuristic+optional-gemini

# =============================================================================
# GOOGLE — Document AI (PDF intake when UPLOAD_PDF_PROVIDER=document-ai)
# =============================================================================

# GOOGLE_CLOUD_PROJECT_ID=
# DOCUMENT_AI_PROCESSOR_ID=
# GOOGLE_APPLICATION_CREDENTIALS=   # path to service account JSON (or use GOOGLE_SERVICE_ACCOUNT)

# =============================================================================
# GOOGLE — Sheets (catalog sync) & general ADC / service account
# =============================================================================

# Preferred: inline JSON or path / ADC
# GOOGLE_SERVICE_ACCOUNT={"type":"service_account",...}
# GOOGLE_SERVICE_ACCOUNT_BASE64=
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/sa.json
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa.json

# Alternate: split email + PEM key
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_CLIENT_EMAIL=            # alias
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Spreadsheet + tab names (defaults shown in code if unset)
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_ID=               # alias
# GOOGLE_SHEETS_TAB_ITEMS=CLEAN_ITEMS
# GOOGLE_SHEETS_TAB_CLEAN_ITEMS=CLEAN_ITEMS
# GOOGLE_SHEETS_TAB_MODIFIERS=CLEAN_MODIFIERS
# GOOGLE_SHEETS_TAB_CLEAN_MODIFIERS=CLEAN_MODIFIERS
# GOOGLE_SHEETS_TAB_BUNDLES=BUNDLES
# GOOGLE_SHEETS_TAB_ALIASES=ALIASES
# GOOGLE_SHEETS_TAB_ATTRIBUTES=ATTRIBUTES

# GOOGLE_SHEETS_AUTH_DEBUG=0

# Catalog sync tuning (see googleSheetsCatalogSync.ts)
# CATALOG_SYNC_REPLACE_MODE=
# CATALOG_SYNC_ALLOW_LEGACY_ITEMS_TAB=0
# CATALOG_SYNC_ALLOW_LEGACY_MODIFIERS_TAB=0
# CATALOG_SYNC_SKIP_STAGING=0
# CATALOG_SYNC_ITEMS_SOURCE=
# CATALOG_SYNC_DEMOTE_ORPHAN_REFS=
# CATALOG_SYNC_PREFLIGHT_STRICT_GENERIC_NAME_ALIASES=
# PUBLISH_BLOCKERS_ALLOWED_CATEGORIES=

# DEFAULT_LABOR_RATE_PER_HOUR=100

# =============================================================================
# GOOGLE — Maps grounding (optional intake / geo)
# =============================================================================

# GOOGLE_MAPS_GROUNDING_ENABLED=0
# GOOGLE_MAPS_GROUNDING_API_KEY=
# GOOGLE_MAPS_API_KEY=            # fallback key
# GOOGLE_MAPS_GROUNDING_MODEL=

# =============================================================================
# GOOGLE — Cloud Storage (SQLite backup or project files alternate backend)
# =============================================================================

# DATABASE_GCS_BUCKET=
# DATABASE_GCS_OBJECT=estimator.db
# DATABASE_GCS_BACKUP_INTERVAL_MS=

# GCS bucket for project files when using GCS mode (see gcsProjectFilesStorage.ts)
# GCS_PROJECT_FILES_BUCKET=

# =============================================================================
# OPENAI — Div 10 Brain (embeddings, RAG); required if using div10 brain features
# =============================================================================

# OPENAI_API_KEY=
# OPENAI_MODEL_CLASSIFY=gpt-4o-mini
# OPENAI_MODEL_DRAFT=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# =============================================================================
# INTAKE — PDF / uploads / parsing
# =============================================================================

# fallback-text | document-ai (see pdfParser / intake-env-smoke)
# UPLOAD_PDF_PROVIDER=fallback-text

# =============================================================================
# ADDRESS SUGGEST (Nominatim)
# =============================================================================

# ADDRESS_SUGGEST_COUNTRY_CODES=
# NOMINATIM_USER_AGENT=

# =============================================================================
# Other providers / features
# =============================================================================

# GOOGLE_NATURAL_LANGUAGE_ENABLED=0

# =============================================================================
# SERVER — catalog lifecycle, project files (SQLite), dev toggles
# =============================================================================

# Sync catalog from Sheets when server starts (see server.ts)
# AUTO_SYNC_CATALOG_ON_START=0

# When DB_DRIVER=sqlite and not using Supabase project files
# PROJECT_FILES_STORAGE=         # disk | (unset for supabase/gcs paths in code paths)
# PROJECT_FILES_DIR=./data/project-files

# ESTIMATOR_DEBUG_PROJECT_AUTOFILL=0

# =============================================================================
# Scripts only (migrations, smoke tests, one-off tools)
# =============================================================================

# SMOKE_HTTP_BASE=http://127.0.0.1:3000
# SQLITE_PATH=./estimator.db
# SQLITE_DB=                     # alias
# DRY_RUN=1
