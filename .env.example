# =============================================================================
# Div 10 Catalog Hub — Vite + React (browser-safe variables only)
# =============================================================================
#
# Copy to `.env.local` (gitignored) and replace the placeholder anon key:
#   Supabase Dashboard → Project Settings → API → Project API keys → anon public
#
# Never set SUPABASE_SERVICE_ROLE_KEY or any server-only secret in VITE_* vars —
# Vite inlines them into the client bundle.
# =============================================================================

VITE_SUPABASE_URL=https://inprhhppwjvkgzddankd.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_PUBLIC_KEY_HERE
VITE_APP_NAME=Div 10 Catalog Hub

