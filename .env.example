# =============================================================================
# Div 10 Catalog Hub / Brighten Install — local/dev + Cloud Run deploy example
# =============================================================================
#
# Copy to `.env.local` (gitignored) for local dev.
# In Cloud Run, prefer Secret Manager for secrets and plain env vars for non-secrets.
#
# Never set SUPABASE_SERVICE_ROLE_KEY or any other server-only secret in VITE_* vars —
# Vite inlines them into the client bundle.
# =============================================================================

# --- Browser-safe Supabase config ---
# Optional at build time because the app also falls back to `/api/v1/public-config.js`
# from the server, but setting these keeps the SPA self-contained in static previews.
VITE_SUPABASE_URL=https://inprhhppwjvkgzddankd.supabase.co
VITE_SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_PUBLIC_KEY_HERE
# Next-style aliases are supported in this Vite app too.
NEXT_PUBLIC_SUPABASE_URL=https://inprhhppwjvkgzddankd.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=PASTE_SUPABASE_ANON_PUBLIC_KEY_HERE
VITE_APP_NAME=Div 10 Catalog Hub

# --- Core server runtime ---
# PORT=3000
# NODE_ENV=development
# DB_DRIVER=pg
# DATABASE_URL=postgresql://postgres.<ref>:PASSWORD@...pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# DIRECT_URL=postgresql://postgres.<ref>:PASSWORD@db.<ref>.supabase.co:5432/postgres?sslmode=require
# CATALOG_BACKEND=pg
# CATALOG_ITEMS_TABLE=public.catalog_items_clean
# AUTO_SYNC_CATALOG_ON_START=1
# DEFAULT_LABOR_RATE_PER_HOUR=95

# --- Supabase server runtime ---
# SUPABASE_URL=https://inprhhppwjvkgzddankd.supabase.co
# SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_PUBLIC_KEY_HERE
# SUPABASE_SERVICE_ROLE_KEY=PASTE_SUPABASE_SERVICE_ROLE_KEY_HERE
# SUPABASE_JWT_SECRET=PASTE_SUPABASE_JWT_SECRET_HERE
# SUPABASE_STORAGE_BUCKET=project-files

# --- Authentication ---
# AUTH_REQUIRED=1
# AUTH_LOGIN_PASSWORD=OPTIONAL_SHARED_PASSWORD_FALLBACK

# --- Google Sheets catalog sync ---
# GOOGLE_SHEETS_SPREADSHEET_ID=PASTE_SPREADSHEET_ID_HERE
# GOOGLE_SHEETS_TAB_ITEMS=CLEAN_ITEMS
# GOOGLE_SHEETS_TAB_MODIFIERS=CLEAN_MODIFIERS
# GOOGLE_SHEETS_TAB_BUNDLES=BUNDLES
# GOOGLE_SHEETS_TAB_ALIASES=ALIASES
# GOOGLE_SHEETS_TAB_ATTRIBUTES=ATTRIBUTES
# GOOGLE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-service-account.json

# --- AI / intake ---
# GEMINI_API_KEY=PASTE_GEMINI_KEY_HERE
# UPLOAD_PDF_PROVIDER=fallback-text
# GOOGLE_CLOUD_PROJECT_ID=your-gcp-project
# DOCUMENT_AI_PROCESSOR_ID=processor-id-or-full-resource-name

# --- Optional SQLite fallback / persistence ---
# DATABASE_PATH=/data/estimator.db
# DATABASE_GCS_BUCKET=your-bucket
# DATABASE_GCS_OBJECT=estimator.db
# DATABASE_SUPABASE_BUCKET=sqlite-backups
# DATABASE_SUPABASE_OBJECT=estimator.db

# Health:
# - GET /healthz (startup / liveness)
# - GET /api/v1/health (API ready)
# - GET /api/v1/catalog-health (Postgres catalog surface; requires DB_DRIVER=pg)
